# Copy this file to .env and fill in your values

# MongoDB Atlas connection string
# Get this from: Atlas Dashboard → Your Cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cc-estimating?retryWrites=true&w=majority

# Session secret — use a long random string in production
SESSION_SECRET=change-me-to-something-random-and-long

# Port (Render sets this automatically; leave blank for local default of 3000)
# PORT=3000
